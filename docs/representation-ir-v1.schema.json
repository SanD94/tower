{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tower.local/schemas/representation-ir-v1.json",
  "title": "Tower Representation IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "subject",
    "frame",
    "units",
    "connections",
    "regions",
    "omissions",
    "diagnostics",
    "transformations"
  ],
  "properties": {
    "schema": { "const": "tower-representation-ir" },
    "schema_version": { "const": 1 },
    "subject": { "$ref": "#/$defs/id" },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "workspace", "worktree", "question", "focus", "viewpoint", "detail", "budget", "assumptions"],
      "properties": {
        "evidence": { "$ref": "#/$defs/id" },
        "workspace": {
          "type": "object",
          "required": ["root", "revision", "dirty", "vcs"],
          "properties": {
            "root": { "type": "string" },
            "revision": { "type": "string" },
            "dirty": { "type": "boolean" },
            "vcs": { "const": "git" }
          }
        },
        "worktree": {
          "type": "object",
          "required": ["files"],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "blob_oid"],
                "properties": {
                  "path": { "type": "string" },
                  "blob_oid": { "type": "string" }
                }
              }
            }
          }
        },
        "question": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "intent", "terms"],
          "properties": {
            "text": { "type": "string" },
            "intent": { "type": "string" },
            "terms": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "focus": { "$ref": "#/$defs/id" },
        "viewpoint": { "type": "string" },
        "detail": { "enum": ["summary", "evidence"] },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_visible_units"],
          "properties": { "max_visible_units": { "type": "integer", "minimum": 1 } }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "transformations": { "type": "array", "items": { "$ref": "#/$defs/transformation" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "unit": {
      "type": "object",
      "required": ["id", "type", "label", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["repository", "file", "heading", "match", "span", "commit"] },
        "label": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "source": { "type": "object" },
        "provenance": { "type": "object" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "target", "evidence", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["contains", "matched-by", "changed-in", "line-attributed-to", "changed-with"] },
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "status": { "enum": ["observed", "historical-inference"] }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "type", "evidence", "reason"],
      "properties": {
        "unit": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "reason": { "enum": ["max-visible-units", "trace", "project"] },
        "hidden_unit": { "$ref": "#/$defs/unit" },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "boundary", "members", "ports", "detail", "budget", "inverse"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "boundary": { "$ref": "#/$defs/id" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "detail": { "enum": ["summary", "evidence"] },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_visible_units"],
          "properties": { "max_visible_units": { "type": "integer", "minimum": 1 } }
        },
        "inverse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remove_units", "remove_connections", "restore_omissions"],
          "properties": {
            "remove_units": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "remove_connections": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "restore_omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } }
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "type", "direction", "outside"],
      "properties": {
        "connection": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "direction": { "enum": ["in", "out"] },
        "outside": { "$ref": "#/$defs/id" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "deterministic", "inputs"],
      "properties": {
        "name": { "enum": ["compile", "refine", "trace", "project", "collapse"] },
        "deterministic": { "const": true },
        "inputs": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "object" }
          ]
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "retained", "omitted"],
          "properties": {
            "added": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "retained": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "omitted": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        }
      }
    }
  }
}
